# Runtime service state: the live order rail is a snapshot, not source.
data/

# Firebase CLI deploy cache. Rewritten by every `firebase deploy`, so tracking
# it meant a dirty tree after each one. Already excluded from what is uploaded
# by the "**/.*" rule in both firebase.json hosting targets.
.firebase/

# Generated close-out exports, never source.
close-out-*.pdf
closeout-*.pdf
preview-*.pdf

# Outreach drafts, not source.
*.eml

# Node
node_modules/
npm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors and agent tooling
.vscode/
.idea/
.claude/
*.swp

# Generated deliverables, never source.
neapolitan-night-floor-guide.pdf
table-tents.html

# Club member roster: 700+ real families and their account numbers. The repo is
# public and everything under the served root is public with it, so the roster
# lives here, outside both. scripts/roster.js reads it; nothing ships it.
private/
