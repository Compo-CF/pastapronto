rules_version = '2';

// PastaPresto Firestore security rules.
//
// POSTURE (same shape as the tasteoff app, with tighter write validation):
// every screen signs in anonymously on load, so requiring an auth token blocks
// drive-by internet traffic while keeping the no-password guest experience. The
// staff passcode on the kitchen/expo/manager screens is a convenience lock in
// the UI, NOT security - it ships in app/config.js where anyone can read it.
//
// WHAT THIS DOES PROTECT:
//   - unauthenticated traffic cannot touch anything
//   - an order's identity is immutable after it is created: its ticket number,
//     claim code, kind, service date and member cannot be rewritten. Its
//     contents can, because a manager has to be able to move a party to
//     another table and fix an order taken verbally - but the result still has
//     to look like an order, and the audit trail only ever grows
//   - new orders must arrive in the 'queued' state with a sane shape
//   - the audit trail can only grow
//
// WHAT IT DOES NOT:
//   - rules cannot re-run the cook-time model, so a hand-crafted client could
//     create an order whose stated cook time disagrees with its contents
//   - rules cannot tell a manager from a guest, so any signed-in client can
//     read the whole day's rail and edit the 86 list
//   - no guest is ever quoted a price; charges post against the member number
//     through the club's own system, which this app never touches. config/costs
//     is the other side of that ledger - what the food cost the kitchen - and
//     any signed-in client can read it, so treat it as venue-visible and never
//     put supplier contract terms in it
// Closing both of those properly means moving writes behind Cloud Functions
// and adding Firebase App Check, which needs the Blaze plan. See README.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Member directory: looked up by the guest keypad, seeded by the manager.
    match /members/{memberNumber} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Shared service configuration: the 86 list and the food-cost sheet.
    //
    // Validated per document rather than in one combined check. The two have
    // nothing in common, and a single rule loose enough to admit both would be
    // loose enough to admit anything - which is how the 86 list would end up
    // writable as a map of prices.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if signedIn() && (
        (docId == 'availability'
          && request.resource.data.unavailable is list
          && request.resource.data.unavailable.size() <= 100)
        ||
        // Costs are manager-entered numbers, not guest input. Rules cannot
        // tell a manager from a guest here any more than they can on the 86
        // list, so this bounds the shape and the size and nothing more.
        (docId == 'costs'
          && request.resource.data.items is map
          && request.resource.data.items.size() <= 200)
        ||
        // Which night the venue is running. A short string and nothing else -
        // the client checks it against config.nights before using it, so an
        // unknown value falls back rather than emptying the menu.
        (docId == 'service'
          && request.resource.data.night is string
          && request.resource.data.night.size() <= 40)
        ||
        // Locations a manager added - the locker room, the halfway house.
        // Bounded in size and nothing more; app/config.js isValidTag() checks
        // each entry's shape on the way out, because a rule that walked a
        // list of maps would be longer than the thing it protects and no
        // stricter where it matters.
        (docId == 'tags'
          && request.resource.data.custom is list
          && request.resource.data.custom.size() <= 60)
      );
    }

    // Ticket-number allocation, one document per service date.
    match /counters/{serviceDate} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.lastTicket is int
        && request.resource.data.lastTicket >= 0;
    }

    match /orders/{orderId} {

      function statuses() {
        return ['queued', 'cooking', 'ready', 'delivered', 'held', 'voided'];
      }

      // A new order must look like a new order.
      function validNewOrder() {
        let d = request.resource.data;
        return d.status == 'queued'
          && d.kind in ['pasta', 'pizza', 'burger']
          && d.ticketNo is int && d.ticketNo > 0
          && d.serviceDate is string
          && d.memberNumber is string
          // Canonical form only: 1-4 digits, no leading zeros, no member zero.
          && d.memberNumber.matches('^[1-9][0-9]{0,3}$')
          // The club seats 12 to a table. These two tracked config.order
          // .maxGuests at 8 and were left behind when it went to 12, so a
          // party of nine built an order the screen accepted and Firestore
          // then refused - the guest saw "Sending..." and a permission error.
          // Rules cannot import config.js; when that number moves, this moves.
          && d.guestCount is int && d.guestCount >= 1 && d.guestCount <= 12
          && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 12
          && d.cookEstimateSec is int && d.cookEstimateSec > 0
          && d.events is list && d.events.size() == 1;
      }

      // A ticket's identity, which nothing may rewrite. These are the fields
      // that say WHICH order this is rather than what is in it: renumber a
      // ticket and the kitchen is calling out a number nobody holds; change
      // the kind and it re-routes to a station that does not cook it.
      function identityIntact() {
        let before = resource.data;
        let after = request.resource.data;
        return after.ticketNo == before.ticketNo
          && after.kind == before.kind
          && after.claimCode == before.claimCode
          && after.serviceDate == before.serviceDate
          && after.submittedAt == before.submittedAt
          && after.memberNumber == before.memberNumber;
      }

      // What a manager may correct on a live ticket: where it goes, how many
      // are eating, and the food itself.
      //
      // This used to be contentsUnchanged(), which froze all of it - the club
      // asked for exactly the opposite, because members move tables and change
      // their minds. The bound that matters is no longer "nothing changed" but
      // "it still looks like an order", so the shape is re-checked here rather
      // than trusted because it was checked once at create.
      function contentsEditable() {
        let after = request.resource.data;
        return after.guestCount is int && after.guestCount >= 1 && after.guestCount <= 12
          && after.lines is list && after.lines.size() >= 1 && after.lines.size() <= 12
          && after.cookEstimateSec is int && after.cookEstimateSec > 0;
      }

      function validUpdate() {
        let after = request.resource.data;
        return after.status in statuses()
          && identityIntact()
          && contentsEditable()
          // The audit trail only ever grows, so an edit cannot erase the
          // record of the edit before it.
          && after.events.size() >= resource.data.events.size();
      }

      allow read: if signedIn();
      allow create: if signedIn() && validNewOrder();
      allow update: if signedIn() && validUpdate();
      // Deletes are the manager's "clear today" button.
      allow delete: if signedIn();
    }
  }
}
